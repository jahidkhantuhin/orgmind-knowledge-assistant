{
  "name": "orgmind",
  "version": "0.1.0",
  "private": true,
  "author": "Jahid Khan Tuhin",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @orgmind/api --filter @orgmind/web dev",
    "setup:local": "pnpm db:migrate && pnpm db:search-indexes && pnpm db:seed",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @orgmind/api db:migrate",
    "db:search-indexes": "pnpm --filter @orgmind/api db:search-indexes",
    "db:seed": "pnpm --filter @orgmind/api db:seed",
    "eval:seed": "pnpm --filter @orgmind/api eval:seed",
    "eval": "pnpm --filter @orgmind/api eval",
    "eval:smoke": "pnpm --filter @orgmind/evals smoke",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test --config apps/web/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.65.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml,css}": "prettier --write"
  }
}
