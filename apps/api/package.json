{
  "name": "@orgmind/api",
  "version": "0.1.0",
  "private": true,
  "author": "Jahid Khan Tuhin",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx ./node_modules/tsx/dist/cli.mjs watch --clear-screen=false --include ../../packages/shared/src src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=../../.env --import tsx scripts/migrate.ts",
    "db:search-indexes": "node --env-file=../../.env --import tsx scripts/search-indexes.ts",
    "db:seed": "node --env-file=../../.env --import tsx scripts/seed.ts",
    "eval:seed": "node --env-file=../../.env --import tsx scripts/eval-seed.ts",
    "eval": "node --env-file=../../.env --import tsx scripts/eval.ts",
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.112",
    "@better-auth/mongo-adapter": "1.7.18",
    "@google/genai": "2.31.0",
    "@langchain/langgraph": "1.7.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@orgmind/evals": "workspace:*",
    "@orgmind/shared": "workspace:*",
    "ai": "7.0.163",
    "better-auth": "1.7.18",
    "bullmq": "5.81.5",
    "cors": "2.8.5",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "mammoth": "1.12.2",
    "mongodb": "7.8.0",
    "multer": "2.5.0",
    "pdf-parse": "2.4.5",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "redis": "5.10.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
